# Supabase: almacenamiento de las solicitudes del formulario.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WordPress headless (Insights). Por omisión usa el sitio de producción.
WORDPRESS_API_URL=https://treulegal.solutions/wp-json/wp/v2

# Secreto del endpoint de revalidación on-demand (/api/revalidate?secret=...).
REVALIDATE_SECRET=

# Correo de las notificaciones del formulario.
# En preview debe apuntar a una direccion de prueba, NUNCA al despacho.
CONTACT_TO=
RESEND_API_KEY=
