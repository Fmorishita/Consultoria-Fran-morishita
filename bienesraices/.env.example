# ------------------------------------------------------------------
# Copia este archivo como .env.local y llénalo. NUNCA subas llaves al repo.
# En Vercel, las mismas variables van en Project Settings → Environment Variables.
# ------------------------------------------------------------------

# URL pública del sitio: canónicas, sitemap y OG.
NEXT_PUBLIC_SITE_URL=https://franmorishita-bienesraices.vercel.app

# --- Supabase (captura de leads) ----------------------------------
# La tabla tiene RLS y la llave publicable solo puede INSERT.
# Crea la tabla con supabase/leads.sql
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_TABLA_LEADS=leads_bienes_raices

# --- Meta (píxel + Conversions API) -------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo para probar en el Test Events de Meta:
META_TEST_EVENT_CODE=

# --- Google Analytics 4 -------------------------------------------
NEXT_PUBLIC_GA4_ID=

# --- Webhooks -----------------------------------------------------
# A donde se manda cada lead (n8n / GoHighLevel).
LEAD_WEBHOOK_URL=
# A donde avisar si algo falla al guardar un lead.
ALERT_WEBHOOK_URL=

# --- Banderas -----------------------------------------------------
# 1 = pinta los chips ámbar con los datos pendientes. Solo en preview.
NEXT_PUBLIC_MOSTRAR_PENDIENTES=
# Indexación: vacío = solo producción se indexa. 1 = forzar sí. 0 = forzar no
# (déjalo en 0 mientras el sitio viva en el subdominio de Vercel).
PERMITIR_INDEXACION=
